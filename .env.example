# Copy to .env. Full list with notes: Project Breakdown.md → Environment Variables.

# App
PUBLIC_APP_URL=http://localhost:5173

# Database (pulled by `neon deploy` / `neon env pull`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# AI
GEMINI_API_KEY=
# Only set to true if the Gemini key is on a paid tier (free tier may train on prompts)
GEMINI_PAID_TIER=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Walrus Memory (server-side only)
MEMWAL_PRIVATE_KEY=
MEMWAL_PUBLIC_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# Optional: Walrus namespace prefix (default createthings-dev locally, createthings in production)
MEMORY_NAMESPACE_PREFIX=

# Tatum
TATUM_API_KEY=

# Notion export (optional)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=

# Dev only: turns on /api/dev/checks under `wrangler dev`
DEV_CHECKS=

# Dev only (npm run dev): 1 = save captures without analysing them (no AI, credits or Walrus)
SKIP_ANALYSIS=

# Connected accounts (needs-input.md K1–K3, K8). Tokens are encrypted with SOURCE_TOKEN_KEY:
# 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
SOURCE_TOKEN_KEY=
ARENA_CLIENT_ID=
ARENA_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email reminders and the weekly digest (needs-input.md K4)
RESEND_API_KEY=
EMAIL_FROM=
# Until sign-in: where the dev user's reminder emails go
OWNER_EMAIL=

# Payments in USDC on Sui (needs-input.md K6)
SUI_PAYMENT_ADDRESS=
# mainnet (default) or testnet, to try payments with test funds
SUI_NETWORK=
# The stronger Gemini model for Pro answers (default gemini-3.5-pro)
GEMINI_PRO_MODEL=

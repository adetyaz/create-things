# Copy to .env. Full list with notes: Project Breakdown.md → Environment Variables.

# App
PUBLIC_APP_URL=http://localhost:5173

# Database (pulled by `neon deploy` / `neon env pull`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# AI
GEMINI_API_KEY=
# Only set to true if the Gemini key is on a paid tier (free tier may train on prompts)
GEMINI_PAID_TIER=
GROQ_API_KEY=

# Walrus Memory (server-side only)
MEMWAL_PRIVATE_KEY=
MEMWAL_PUBLIC_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# Optional: Walrus namespace prefix (default createthings-dev locally, createthings in production)
MEMORY_NAMESPACE_PREFIX=

# Tatum
TATUM_API_KEY=

# Dev only: turns on /api/dev/checks under `wrangler dev`
DEV_CHECKS=

# Dev only (npm run dev): 1 = save captures without analysing them (no AI, credits or Walrus)
SKIP_ANALYSIS=

# Connected accounts: Are.na, Google Calendar (needs-input.md). Tokens are encrypted with SOURCE_TOKEN_KEY:
# 32 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
SOURCE_TOKEN_KEY=
ARENA_CLIENT_ID=
ARENA_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email reminders and the weekly digest (needs-input.md)
RESEND_API_KEY=
EMAIL_FROM=
# Your email: reminder emails before sign-in, and your first sign-in keeps the dev user's data
OWNER_EMAIL=

# Sign-in (needs-input.md): a 32+ character random secret; REQUIRE_SIGN_IN=true turns it on
BETTER_AUTH_SECRET=
REQUIRE_SIGN_IN=

# Payments in USDC on Sui (needs-input.md)
SUI_PAYMENT_ADDRESS=
# mainnet (default) or testnet, to try payments with test funds
SUI_NETWORK=
# The stronger Gemini model for Pro answers (default gemini-3.5-pro)
GEMINI_PRO_MODEL=

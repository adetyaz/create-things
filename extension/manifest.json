{
	"manifest_version": 3,
	"name": "createthings",
	"description": "Save anything to createthings in one click: pages, screenshots, X posts and \"I want to\u2026\" ideas. Your pet helps you start.",
	"version": "0.2.0",
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"action": {
		"default_popup": "popup/index.html",
		"default_title": "createthings",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"background": {
		"service_worker": "service-worker.js",
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["screenshot.js"],
			"run_at": "document_idle",
			"all_frames": false
		},
		{
			"matches": ["https://x.com/*", "https://twitter.com/*"],
			"js": ["x-save.js"],
			"run_at": "document_idle",
			"all_frames": false
		}
	],
	"permissions": ["activeTab", "storage", "tabs", "scripting", "alarms"],
	"host_permissions": ["<all_urls>"],
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	}
}

{
	"manifest_version": 3,
	"name": "createthings",
	"description": "Your creative OS — capture inspiration, analyze it with AI, learn from it, create your own work, and publish with proper attribution.",
	"version": "0.1.0",

	"action": {
		"default_popup": "popup/index.html",
		"default_title": "createthings"
	},
	"background": {
		"service_worker": "service-worker.js",
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["screenshot.js"],
			"run_at": "document_idle",
			"all_frames": false
		}
	],
	"permissions": ["activeTab", "storage", "tabs", "scripting"],
	"host_permissions": ["<all_urls>"],
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	}
}

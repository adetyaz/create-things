{
	"manifest_version": 3,
	"name": "createthings",
	"description": "Save anything to createthings in one click: pages, screenshots, posts from the sites you use and \"I want to\u2026\" ideas. Your pet helps you start.",
	"version": "0.3.0",
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"action": {
		"default_popup": "popup/index.html",
		"default_title": "createthings",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"background": {
		"service_worker": "service-worker.js",
		"type": "module"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["screenshot.js"],
			"run_at": "document_idle",
			"all_frames": false
		},
		{
			"matches": [
				"https://x.com/*",
				"https://twitter.com/*",
				"https://*.pinterest.com/*",
				"https://www.are.na/*",
				"https://are.na/*",
				"https://www.youtube.com/*",
				"https://www.instagram.com/*",
				"https://dribbble.com/*",
				"https://www.behance.net/*",
				"https://www.reddit.com/*",
				"https://github.com/*"
			],
			"js": ["site-save.js"],
			"run_at": "document_idle",
			"all_frames": false
		}
	],
	"commands": {
		"save-page": {
			"suggested_key": { "default": "Alt+Shift+S" },
			"description": "Save this page to createthings"
		},
		"pick-area": {
			"suggested_key": { "default": "Alt+Shift+A" },
			"description": "Pick an area of the page to save"
		}
	},
	"permissions": [
		"activeTab",
		"storage",
		"tabs",
		"scripting",
		"alarms",
		"contextMenus",
		"notifications",
		"unlimitedStorage"
	],
	"host_permissions": ["<all_urls>"],
	"externally_connectable": {
		"matches": ["http://localhost:5173/*", "https://*.workers.dev/*"]
	},
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	}
}

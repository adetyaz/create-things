{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "createthings",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"hyperdrive": [
		{
			// createthings-db → Neon production (DATABASE_URL_UNPOOLED).
			// Locally, `npm run dev` / `npm run dev:worker` point this binding straight at Neon instead.
			"binding": "HYPERDRIVE",
			"id": "4f59b630d8b54bb0bfbff44e4ba34d46"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"queues": {
		"producers": [
			{ "binding": "ANALYSIS_QUEUE", "queue": "createthings-analysis" },
			{ "binding": "MEMORY_QUEUE", "queue": "createthings-memory" }
		],
		// Handled by queue() in scripts/worker-entry.js → /api/internal/queue/[queue]
		"consumers": [
			{
				"queue": "createthings-analysis",
				"max_batch_size": 5,
				"max_retries": 3,
				"dead_letter_queue": "createthings-analysis-dlq"
			},
			{
				// One at a time, so the Walrus relayer's rate limits hold
				"queue": "createthings-memory",
				"max_batch_size": 1,
				"max_concurrency": 1,
				"max_retries": 5,
				"dead_letter_queue": "createthings-memory-dlq"
			}
		]
	},
	"env": {
		// Local development (`npm run dev`, `npm run dev:worker`): same bindings minus Workers AI,
		// which only runs on Cloudflare and would open a remote session. Analysis uses Gemini, then Groq.
		// Hyperdrive, queues and ai aren't inherited by environments, so they're repeated here.
		"local": {
			"vars": { "LOCAL_DEV": "true" },
			"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "4f59b630d8b54bb0bfbff44e4ba34d46" }],
			"queues": {
				"producers": [
					{ "binding": "ANALYSIS_QUEUE", "queue": "createthings-analysis" },
					{ "binding": "MEMORY_QUEUE", "queue": "createthings-memory" }
				],
				"consumers": [
					{
						"queue": "createthings-analysis",
						"max_batch_size": 5,
						"max_retries": 3,
						"dead_letter_queue": "createthings-analysis-dlq"
					},
					{
						"queue": "createthings-memory",
						"max_batch_size": 1,
						"max_concurrency": 1,
						"max_retries": 5,
						"dead_letter_queue": "createthings-memory-dlq"
					}
				]
			}
		}
	}
	// Other bindings (KV, R2) are added as each resource is created.
	// Secrets: `.env` locally (passed with --env-file), `wrangler secret put` in production.
}
